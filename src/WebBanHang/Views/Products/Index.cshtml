@model List<Product>
@{ ViewData["Title"] = "Sản phẩm"; }
<div class="page-heading"><div><p class="eyebrow">KHO HÀNG CỦA BẠN</p><h1>Sản phẩm<span class="accent">.</span></h1><p class="muted">Theo dõi giá bán, danh mục và số lượng tồn kho.</p></div><a class="button primary" asp-action="Create">+ Thêm sản phẩm</a></div>
<section class="panel"><form class="filter-bar" method="get"><div><label for="q" class="sr-only">Tìm sản phẩm</label><input id="q" name="q" value="@ViewBag.Query" placeholder="Tìm tên sản phẩm…" /></div><div><label for="categoryId" class="sr-only">Danh mục</label><select id="categoryId" name="categoryId" asp-items="ViewBag.Categories"><option value="">Tất cả danh mục</option></select></div><div><label for="lowStock" class="sr-only">Mức tồn kho</label><select id="lowStock" name="lowStock"><option value="false">Tất cả tồn kho</option><option value="true" selected="@(ViewBag.LowStock == true)">Sắp hết (≤ 8)</option></select></div><button class="button" type="submit">Lọc sản phẩm</button><a asp-action="Index">Xóa bộ lọc</a></form>
<div class="table-wrap"><table><thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Giá bán</th><th>Tồn kho</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var p in Model) { <tr><td><div class="product-name"><span class="product-tile" aria-hidden="true">@p.Name[..1]</span><div><strong>@p.Name</strong><small>SP@(p.Id.ToString("D4"))</small></div></div></td><td>@p.Category?.Name</td><td class="money">@p.Price.ToString("N0") đ</td><td><span class="badge @(p.Stock <= 8 ? "warning" : "")">@p.Stock còn lại</span></td><td><div class="actions"><a asp-action="Edit" asp-route-id="@p.Id">Sửa</a><form asp-action="Delete" asp-route-id="@p.Id" method="post" data-confirm="Xóa sản phẩm này?"><button type="submit" class="text-button danger">Xóa</button></form></div></td></tr> }
@if (Model.Count == 0) { <tr><td colspan="5" class="empty-cell">Không tìm thấy sản phẩm phù hợp.</td></tr> }
</tbody></table></div><div class="panel-foot">@Model.Count sản phẩm trong danh sách</div></section>
