@model SalesOrder
@{ ViewData["Title"] = $"Đơn DH{Model.Id:D4}"; var subtotal = Model.Items.Sum(i => i.UnitPrice * i.Quantity); }
<a class="back-link" asp-action="Index">← Đơn hàng</a><div class="page-heading"><div><p class="eyebrow">CHI TIẾT ĐƠN HÀNG</p><h1>#DH@(Model.Id.ToString("D4"))<span class="accent">.</span></h1><p class="muted">@Model.CustomerName · @Model.Phone · @Model.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm") (VN)</p></div><span class="badge large">@Model.Status</span></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead><tbody>@foreach (var i in Model.Items) { <tr><td><strong>@i.ProductName</strong></td><td>@i.UnitPrice.ToString("N0") đ</td><td>@i.Quantity</td><td class="money">@((i.UnitPrice * i.Quantity).ToString("N0")) đ</td></tr> }</tbody></table></div><div class="order-totals"><p>Tạm tính <strong>@subtotal.ToString("N0") đ</strong></p><p>Giảm giá <strong>@Model.DiscountPercent.ToString("0.##")%</strong></p><p class="grand-total">Tổng thanh toán <strong>@Model.Total.ToString("N0") đ</strong></p></div>
@if (Model.Status == "Mới") { <div class="form-actions padded"><form asp-action="UpdateStatus" method="post"><input name="id" value="@Model.Id" type="hidden" /><input name="status" value="Hoàn tất" type="hidden" /><button class="button primary" type="submit">Hoàn tất đơn hàng</button></form><form asp-action="UpdateStatus" method="post" data-confirm="Hủy đơn và hoàn lại tồn kho?"><input name="id" value="@Model.Id" type="hidden" /><input name="status" value="Đã hủy" type="hidden" /><button class="button" type="submit">Hủy đơn hàng</button></form></div> }
</section>
