@model CreateOrderInput
@{ ViewData["Title"] = "Tạo đơn hàng"; var products = (List<Product>)ViewBag.Products; }
<a class="back-link" asp-action="Index">← Đơn hàng</a><div class="page-heading"><div><p class="eyebrow">BÁN HÀNG</p><h1>Tạo đơn hàng<span class="accent">.</span></h1><p class="muted">Giá bán và tồn kho được kiểm tra lại khi lưu đơn.</p></div></div>
<form asp-action="Create" method="post" class="panel order-form"><div asp-validation-summary="All" class="validation" role="alert"></div><h2>Thông tin khách hàng</h2><div class="form-grid"><div class="field"><label asp-for="CustomerName"></label><input asp-for="CustomerName" required maxlength="100" placeholder="Nguyễn Văn An" /></div><div class="field"><label asp-for="Phone"></label><input asp-for="Phone" type="tel" maxlength="20" placeholder="0901234567" /></div></div>
<div class="section-heading"><h2>Sản phẩm trong đơn</h2><button class="button" type="button" id="add-line">+ Thêm dòng</button></div><div id="order-lines">
@for (var i = 0; i < Model.Lines.Count; i++) { <div class="order-line"><div class="field"><label for="product-@i">Sản phẩm</label><select id="product-@i" name="Lines[@i].ProductId" required><option value="">Chọn sản phẩm</option>@foreach (var p in products) { <option value="@p.Id" selected="@(Model.Lines[i].ProductId == p.Id)">@p.Name · @p.Price.ToString("N0") đ · còn @p.Stock</option> }</select></div><div class="field"><label for="quantity-@i">Số lượng</label><input id="quantity-@i" name="Lines[@i].Quantity" type="number" min="1" max="10000" value="@Model.Lines[i].Quantity" required /></div><button class="text-button danger remove-line" type="button" aria-label="Xóa dòng sản phẩm">Xóa</button></div> }
</div><div class="field discount-field"><label asp-for="DiscountPercent"></label><input name="DiscountPercent" id="DiscountPercent" value="@Model.DiscountPercent.ToString("0", System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="100" step="1" required /><small>Tổng tiền = tổng (giá × số lượng) × (1 − giảm giá / 100).</small></div><div class="form-actions"><button class="button primary" type="submit">Tạo đơn hàng</button><a class="button" asp-action="Index">Hủy</a></div></form>
