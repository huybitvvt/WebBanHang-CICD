@model List<Category>
@{ ViewData["Title"] = "Danh mục"; }
<div class="page-heading"><div><p class="eyebrow">TỔ CHỨC KHO HÀNG</p><h1>Danh mục<span class="accent">.</span></h1><p class="muted">Phân loại sản phẩm để quản lý dễ dàng hơn.</p></div><a class="button primary" asp-action="Create">+ Thêm danh mục</a></div>
<section class="panel"><form class="filter-bar" method="get"><div><label for="q" class="sr-only">Tìm danh mục</label><input id="q" name="q" value="@ViewBag.Query" placeholder="Tìm tên danh mục…" /></div><button class="button" type="submit">Tìm danh mục</button><a asp-action="Index">Xóa bộ lọc</a></form><div class="table-wrap"><table><thead><tr><th>Mã</th><th>Danh mục</th><th>Mô tả</th><th>Sản phẩm</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var c in Model) { <tr><td class="muted">DM@(c.Id.ToString("D3"))</td><td><strong>@c.Name</strong></td><td>@c.Description</td><td><span class="badge">@c.Products.Count sản phẩm</span></td><td><div class="actions"><a asp-action="Edit" asp-route-id="@c.Id">Sửa</a><form asp-action="Delete" asp-route-id="@c.Id" method="post" data-confirm="Xóa danh mục này?"><button class="text-button danger" type="submit">Xóa</button></form></div></td></tr> }
@if (Model.Count == 0) { <tr><td colspan="5" class="empty-cell">Chưa có danh mục.</td></tr> }
</tbody></table></div></section>
